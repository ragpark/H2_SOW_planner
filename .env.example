# On a host that reports its own public domain (such as Railway), only the
# database connection is strictly required.

# ---- Core ----
PORT=3000
NODE_ENV=production

# Public HTTPS base URL. LTI redirect URIs derive from it, so it must match what
# is registered with the platform. Derived from RAILWAY_PUBLIC_DOMAIN when unset;
# set it explicitly when using a custom domain.
# TOOL_URL=https://sow-planner.example.school

# ---- Database (required) ----
# PostgreSQL holds every scheme of work, lesson note and LTI registration.
# On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/database
# TLS is enabled automatically unless the host is local or on a private network.
# Override with: disable | require | no-verify
# PGSSLMODE=
# DATABASE_POOL_MAX=10

# ---- Migrating from the SQLite version ----
# A pre-Postgres SQLite file is imported once, then recorded in data_migrations.
# Defaults to <volume>/sow.db when a volume is mounted.
# SQLITE_IMPORT_PATH=/data/sow.db
# SQLITE_IMPORT=off

# ---- Modes ----
STANDALONE_ENABLED=true
LTI_ENABLED=true

# ---- LTI 1.3 ----
# Shared secret protecting the platform-registration endpoint. Leave unset to
# disable registration over HTTP entirely.
# LTI_ADMIN_TOKEN=
LTI_KEY_ID=h2-sow-planner-key-1
LTI_CLOCK_TOLERANCE=60

# There is deliberately no SESSION_SECRET: session tokens are random opaque
# values stored in the database, so nothing is signed.
