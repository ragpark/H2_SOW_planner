# Every setting here is optional. On a host that reports its own public domain
# and volume mount (such as Railway), the app derives what it needs.

# ---- Core ----
PORT=3000
NODE_ENV=production

# Public HTTPS base URL. LTI redirect URIs derive from it, so it must match what
# is registered with the platform. Derived from RAILWAY_PUBLIC_DOMAIN when unset;
# set it explicitly when using a custom domain.
# TOOL_URL=https://sow-planner.example.school

# Where the SQLite database lives. Derived from RAILWAY_VOLUME_MOUNT_PATH when
# unset. This MUST be on storage that survives a deploy: it holds every scheme
# of work and every LTI platform registration.
# DATABASE_FILE=/data/sow.db
# Set on non-Railway hosts to confirm the path above is a real volume, which
# silences the ephemeral-storage warning.
# DATABASE_PERSISTENT=1

# ---- Modes ----
# Allow teachers to sign in without an LMS. Set to false for an LTI-only deployment.
STANDALONE_ENABLED=true
LTI_ENABLED=true

# ---- LTI 1.3 ----
# Shared secret protecting the platform-registration endpoint. Leave unset to
# disable registration over HTTP entirely.
# LTI_ADMIN_TOKEN=
LTI_KEY_ID=h2-sow-planner-key-1
LTI_CLOCK_TOLERANCE=60

# There is deliberately no SESSION_SECRET: session tokens are random opaque
# values stored in the database, so nothing is signed.
